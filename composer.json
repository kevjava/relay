{
    "name": "relay/relay",
    "description": "Relay - Lightweight PHP CMS for government content management",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "erusev/parsedown": "^1.7",
        "erusev/parsedown-extra": "^0.8"
    },
    "autoload": {
        "files": [
            "lib/auth.php",
            "lib/csrf.php",
            "lib/content.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text",
        "test:coverage-html": "XDEBUG_MODE=coverage phpunit --coverage-html coverage-html"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}